  {
   "id": "p05-code",
   "kind": "code",
   "text": "def merge_sorted(a, b):\n    \"\"\"Merge two sorted lists into one sorted list.\"\"\"\n    i = j = 0\n    out = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            out.append(a[i])\n            i += 1\n        else:\n            out.append(b[j])\n            j += 1\n    out.extend(a[i:])\n    out.extend(b[j:])\n    return out\n\n\nif __name__ == \"__main__\":\n    print(merge_sorted([1, 4, 9], [2, 3, 10, 11]))\n",
